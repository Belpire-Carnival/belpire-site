// Cloudflare Workers config for belpire.com.
// Workers Builds runs `npm run build` (scripts/cf-build.mjs: Steam feed) and then deploys:
//   • site/      static pages, served straight from Cloudflare's edge
//   • worker/    a little server code: Discord login, members-only pages, /api/*, and the
//                Star Citizen refresh (Cron Trigger)
// Preview builds run "npx wrangler preview" (Cloudflare › Settings › Build › Previews Base).
{
  "name": "belpire-site", // must match the Worker's name in the Cloudflare dashboard
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    // Only these paths run code; every other page is plain static files.
    "run_worker_first": ["/api/*", "/auth/*", "/members", "/members/*"],
    "not_found_handling": "404-page"
  },
  "vars": {
    // Discord login (see README › Members' Lounge). These IDs aren't secrets.
    // Secrets DISCORD_CLIENT_SECRET and SESSION_SECRET are set in the Cloudflare dashboard.
    "DISCORD_CLIENT_ID": "REPLACE_WITH_DISCORD_APPLICATION_ID",
    "DISCORD_GUILD_ID": "REPLACE_WITH_DISCORD_SERVER_ID",
    "DISCORD_REQUIRED_ROLE_IDS": "" // optional: role ID(s), comma-separated; empty = any server member
  },
  "kv_namespaces": [
    // Workers KV namespace "belpire-site" (Storage & Databases › Workers KV). IDs aren't secrets.
    { "binding": "SC_DATA", "id": "383c9c02baf3405b826636f5650f2078" }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"] // Star Citizen status + Comm-Link refresh
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  // belpire-site.<account>.workers.dev stays on so PR preview URLs work.
  "workers_dev": true,
  "previews": {},
  "preview_urls": true
}
