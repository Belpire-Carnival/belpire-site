{
  "name": "belpire-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"],
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    { "binding": "SC_DATA", "id": "383c9c02baf3405b826636f5650f2078" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "belpire-polls", "database_id": "a4cd8c8c-56b3-44b8-9599-b86e3b0cd036" }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "workers_dev": true,
  "previews": {},
  "preview_urls": true
}
